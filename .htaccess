# Ruen Thai — Apache-Konfiguration für Hostpoint (VORSCHAU: ohne Passwortschutz, aber noindex)
# Öffentlich erreichbar, Suchmaschinen sollen die Seite noch nicht aufnehmen.
# Zum Livegang: dieses File durch .htaccess.live ersetzen (siehe README).
RewriteEngine On

# HTTPS erzwingen (301)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# .html in der Adresse auf saubere URL umleiten
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Saubere URLs auf .html-Dateien abbilden
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

ErrorDocument 404 /404.html
DirectoryIndex index.html

<FilesMatch "^(gate\.config\.php|gate\.php|\.htaccess|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
