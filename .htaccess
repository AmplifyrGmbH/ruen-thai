# Ruen Thai — Apache-Konfiguration für Hostpoint (STAGING: Passwortschutz + noindex)
# Alle Anfragen laufen über gate.php (HTTP-Basic-Auth, X-Robots-Tag noindex).
# Zum Livegang: dieses File durch .htaccess.live ersetzen (siehe README).
RewriteEngine On

# HTTPS erzwingen (301)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Authorization-Header an PHP (FastCGI) durchreichen
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Alles über das Gate
RewriteCond %{REQUEST_URI} !^/gate\.php$
RewriteRule ^ /gate.php [L]

Header always set X-Robots-Tag "noindex, nofollow, noarchive"

<FilesMatch "^(gate\.config\.php|\.htaccess|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
